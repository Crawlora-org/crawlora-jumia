        "parameters": [
          {
            "description": "Jumia country storefront",
            "enum": [
              "ci",
              "eg",
              "ke",
              "ma",
              "ng",
              "sn"
            ],
            "in": "query",
            "name": "country",
            "required": true,
            "type": "string",
            "x-example": "ng"
