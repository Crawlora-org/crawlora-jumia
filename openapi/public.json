          {
            "default": 1,
            "description": "1-based page of URLs",
            "in": "query",
            "minimum": 1,
            "name": "page",
            "type": "integer"
          },
          {
            "default": 1000,
            "description": "URLs per page",
            "in": "query",
            "maximum": 5000,
            "minimum": 1,
            "name": "page_size",
            "type": "integer"
          }
        ],
        "produces": [
          "application/json"
