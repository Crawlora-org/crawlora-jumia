    "/jumia/sitemap-urls": {
      "get": {
        "description": "Returns one page of the URLs listed in a Jumia sitemap file, each with its last-modified date and first image, plus the total number of URLs in the file. A product file holds up to 16,000 product URLs; page through it with page and page_size (up to 5000). Take the file name from jumia-sitemaps. A page past the end returns an empty list. Jumia sits behind an anti-bot challenge that clears on only some connections, so a call can take up to about 50 seconds and may return 503; retry it. country is required; see jumia-countries.",
        "operationId": "jumia-sitemap-urls",
        "parameters": [
          {
            "description": "Jumia country storefront",
            "enum": [
              "ci",
              "eg",
              "ke",
              "ma",
              "ng",
              "sn"
            ],
            "in": "query",
            "name": "country",
            "required": true,
            "type": "string",
            "x-example": "ng"
          },
          {
            "description": "Sitemap file name from jumia-sitemaps",
            "in": "query",
            "name": "sitemap",
            "required": true,
            "type": "string",
            "x-example": "products-sitemap-9.xml.gz"
