          {
            "description": "Product search keyword",
            "in": "query",
            "name": "q",
            "required": true,
            "type": "string",
            "x-example": "wireless earbuds"
          },
          {
            "default": 1,
            "description": "1-based result page, 1 to 50",
            "in": "query",
            "maximum": 50,
            "minimum": 1,
            "name": "page",
            "type": "integer"
